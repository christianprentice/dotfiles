# ==============================================================================
# SWAY CONFIGURATION FILE
# ==============================================================================

# ==============================================================================
# 1. VARIABLES (Core Settings & Default Apps)
# ==============================================================================
# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Preferred Applications
set $term ghostty
set $browser brave-browser-beta
set $menu wofi --show drun

# Keyboard repeat rates
set $repeat_delay 50
set $repeat_rate 5

# Color Variables
set $white #f2f4f8
set $black #0c0c0c
set $gray  #8c8e90
set $blue  #6ba9ff

# ==============================================================================
# 2. APPEARANCE & THEMING
# ==============================================================================
# Font
font pango: 0xProto-custom Medium 12

# Wallpaper
output * bg $HOME/Pictures/Wallpapers/alligator.jpg fill

# Cursors
seat * xcursor_theme breeze_cursors 24

# GTK Theming
set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema gtk-theme 'Breeze-Dark'
    gsettings set $gnome-schema icon-theme 'breeze-dark'
    gsettings set $gnome-schema cursor-theme 'breeze_cursors'
    gsettings set $gnome-schema font-name 'Red Hat Text 12'
    gsettings set $gnome-schema color-scheme 'prefer-dark'
}

# Window Borders & Colors
default_border pixel 1
hide_edge_borders smart

# class                 border  background text   indicator child_border
client.focused          $gray   $gray      $black $white
client.focused_inactive $black  $black     $white $black

# ==============================================================================
# 3. HARDWARE & AUTOSTART
# ==============================================================================
# Daemons and Background Services
exec swayidle -w
exec fcitx5

# Display Output scripts
exec_always $HOME/.config/sway/clamshell-mode.sh

# ==============================================================================
# 4. GENERAL KEYBINDINGS
# ==============================================================================
# Basics
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+b exec $browser
bindsym $mod+Shift+q kill

# System Controls
bindsym $mod+Shift+c reload
bindsym $mod+Shift+s exec systemctl suspend
bindsym $mod+Shift+e exec $HOME/.config/sway/confirm-exit.sh

# ==============================================================================
# 5. WINDOW MANAGEMENT
# ==============================================================================
# Moving focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+a focus parent

# Moving windows
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout modes
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen

# Floating mode
floating_modifier $mod normal
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# ==============================================================================
# 6. WORKSPACES (Custom Dvorak Bindings)
# ==============================================================================
# Switch to workspace
bindsym $mod+plus workspace 1
bindsym $mod+bracketleft workspace 2
bindsym $mod+braceleft workspace 3
bindsym $mod+parenleft workspace 4
bindsym $mod+ampersand workspace 5
bindsym $mod+equal workspace 6
bindsym $mod+parenright workspace 7
bindsym $mod+braceright workspace 8
bindsym $mod+bracketright workspace 9
bindsym $mod+asterisk workspace 10

# Move focused container to workspace
bindsym $mod+1 move container to workspace number 1
bindsym $mod+2 move container to workspace number 2
bindsym $mod+3 move container to workspace number 3
bindsym $mod+4 move container to workspace number 4
bindsym $mod+5 move container to workspace number 5
bindsym $mod+6 move container to workspace number 6
bindsym $mod+7 move container to workspace number 7
bindsym $mod+8 move container to workspace number 8
bindsym $mod+9 move container to workspace number 9
bindsym $mod+0 move container to workspace number 10

# ==============================================================================
# 7. RESIZE MODE
# ==============================================================================
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ==============================================================================
# 8. STATUS BAR & INCLUDES
# ==============================================================================
bar {
    swaybar_command waybar
}

include /etc/sway/config.d/*
