{
    "layer": "top",
    "position": "bottom",
    "modules-left": [
        "river/tags"
    ],
	"modules-center": [
        "clock"
	],
	"modules-right": [
		"pulseaudio",
		"memory",
		"cpu",
		"battery",
		"disk",
		"tray"
	],

    "river/tags": {
        "format": "{name}",
        "focus-on-click": true,
		"disable-scroll": true,
        "num-tags": 10
    },

    "clock": {
        "format": "{:%a  %I:%M %p  %m-%d}"
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": " {ifname}",
        "format-disconnected": ""
    },
    "pulseaudio": {
        "format": "{icon} {volume:2}%",
		"format-bluetooth": "{icon}  {volume}%",
        "format-muted": "",
        "format-icons": {
			"headphones": "",
            "default": ["", "", ""]
        },
		"scroll-step": 5,
		"on-click": "pamixer -t",
		"on-click-right": "pavucontrol"
    },
	"memory": {
		"interval": 5,
		"format": "Mem {}%"
	},
	"cpu": {
		"interval": 5,
		"format": "CPU {usage:2}%"
	},
	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"disk": {
		"interval": 5,
		"format": "Disk {percentage_used:2}%",
		"path": "/"
	},
	"tray": {
		"icon-size": 16
	}
}
